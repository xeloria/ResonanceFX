<?xml version="1.0" encoding="utf-8"?>
<!-- Effect catalogue: section titles, control labels, choice options and value formats. -->
<resources>

    <!-- Sections -->
    <string name="section_master_title">Master</string>
    <string name="section_master_summary">Output gain, balance and the final limiter.</string>
    <string name="section_autoeq_title">AutoEQ</string>
    <string name="section_autoeq_summary">Measured correction for thousands of headphones — sound as their makers intended.</string>
    <string name="section_loud_title">Loudness compensation</string>
    <string name="section_loud_summary">Keeps bass and treble full at low volume, following ISO 226 equal-loudness contours.</string>
    <string name="section_peq_title">Parametric EQ</string>
    <string name="section_peq_summary">Your own filters: peaks, shelves, passes and notches, up to 32 bands.</string>
    <string name="section_geq_title">Fine graphic EQ</string>
    <string name="section_geq_summary">15 or 31 bands, each slider hit within a fraction of a dB.</string>
    <string name="section_agc_title">Playback gain control</string>
    <string name="section_agc_summary">Lifts quiet tracks and videos to an even level. For short sounds, use a compressor.</string>
    <string name="section_fet_title">FET compressor</string>
    <string name="section_fet_summary">Studio-style compressor with automatic attack, release and knee.</string>
    <string name="section_ddc_title">Headphone correction</string>
    <string name="section_ddc_summary">Frequency-response correction from a .vdc headset profile.</string>
    <string name="section_vse_title">Spectrum extension</string>
    <string name="section_vse_summary">Restores high frequencies lost to lossy compression.</string>
    <string name="section_eq_title">Equalizer</string>
    <string name="section_eq_summary">10-band equalizer with %1$d presets.</string>
    <string name="section_conv_title">Convolver</string>
    <string name="section_conv_summary">Applies an impulse response: rooms, speakers, headphone targets.</string>
    <string name="section_mbc_title">Multiband compressor</string>
    <string name="section_mbc_summary">Compresses lows, mids and highs separately: denser, more even sound without pumping.</string>
    <string name="section_deq_title">Dynamic EQ</string>
    <string name="section_deq_summary">EQ that only acts when needed: tames boom and harshness, lifts detail at low levels.</string>
    <string name="section_deess_title">De-esser</string>
    <string name="section_deess_summary">Softens sharp &quot;s&quot; and &quot;t&quot; sounds.</string>
    <string name="section_vocal_title">Vocals &amp; ambience</string>
    <string name="section_vocal_summary">Separates the centre (voices) from the surroundings: dialogue boost or karaoke. Adds ~21 ms latency.</string>
    <string name="section_spatial_title">Spatial audio</string>
    <string name="section_spatial_summary">Virtual speakers in a room for headphones, measured on a real head (MIT KEMAR, 710 positions), with 3DoF head tracking: turn, tilt and roll.</string>
    <string name="section_field_title">Field surround</string>
    <string name="section_field_summary">Widens the stereo image.</string>
    <string name="section_diff_title">Differential surround</string>
    <string name="section_diff_summary">Haas-effect spaciousness.</string>
    <string name="section_stereo_title">Stereo widening</string>
    <string name="section_stereo_summary">Widens the image; the centre stays put.</string>
    <string name="section_vhe_title">Headphone surround+</string>
    <string name="section_vhe_summary">Virtual speakers for headphones.</string>
    <string name="section_reverb_title">Reverberation</string>
    <string name="section_reverb_summary">Room ambience.</string>
    <string name="section_dyn_title">Dynamic system</string>
    <string name="section_dyn_summary">Dynamic bass tuned to your headphone type.</string>
    <string name="section_tube_title">Tube simulator</string>
    <string name="section_tube_summary">6N1J vacuum-tube warmth.</string>
    <string name="section_bass_title">Bass enhancer</string>
    <string name="section_bass_summary">Deep, controlled low end.</string>
    <string name="section_clarity_title">Clarity enhancer</string>
    <string name="section_clarity_summary">Treble detail and vocal presence.</string>
    <string name="section_cure_title">Auditory protection</string>
    <string name="section_cure_summary">Crossfeed that reduces listening fatigue on headphones.</string>
    <string name="section_analogx_title">AnalogX</string>
    <string name="section_analogx_summary">Analog-console harmonic coloration.</string>
    <string name="section_speaker_title">Speaker correction</string>
    <string name="section_speaker_summary">Natural balance on phone, laptop, Bluetooth, car and TV speakers, or on yours, measured.</string>
    <string name="section_protect_title">Speaker protection</string>
    <string name="section_protect_summary">Holds back bass a small speaker can\'t play, so it goes louder without rattling or distorting.</string>
    <string name="section_xtc_title">Speaker widening</string>
    <string name="section_xtc_summary">Crosstalk cancellation: stereo that reaches past the edges of a phone, tablet or laptop.</string>

