    <string name="channel_service">エフェクトエンジン</string>
    <string name="notification_text">%1$s プロファイル · 接続中のストリーム: %2$d</string>

    <string name="section_master_title">マスター</string>
    <string name="section_master_summary">出力ゲイン、バランス、最終リミッター。</string>
    <string name="section_autoeq_title">AutoEQ</string>
    <string name="section_autoeq_summary">数千のヘッドホン向けの実測補正 — メーカーの意図どおりの音に。</string>
    <string name="section_loud_title">ラウドネス補正</string>
    <string name="section_loud_summary">ISO 226 の等ラウドネス曲線に従い、小音量でも低音と高音を保ちます。</string>
    <string name="section_peq_title">パラメトリック EQ</string>
    <string name="section_peq_summary">ピーク、シェルフ、パス、ノッチを最大32バンドまで。</string>
    <string name="section_geq_title">高精度グラフィック EQ</string>
    <string name="section_geq_summary">15または31バンド。各スライダーを1dB未満の単位で調整できます。</string>
    <string name="section_agc_title">再生ゲイン制御</string>
    <string name="section_agc_summary">小さい曲や動画を均一な音量に持ち上げます。短い音にはコンプレッサーを。</string>
    <string name="section_fet_title">FET コンプレッサー</string>
    <string name="section_fet_summary">アタック、リリース、ニーが自動のスタジオ式コンプレッサー。</string>
    <string name="section_ddc_title">ヘッドホン補正</string>
    <string name="section_ddc_summary">.vdc ヘッドセットプロファイルによる周波数特性の補正。</string>
    <string name="section_vse_title">スペクトル拡張</string>
    <string name="section_vse_summary">非可逆圧縮で失われた高域を復元します。</string>
    <string name="section_eq_title">イコライザー</string>
    <string name="section_eq_summary">%1$d 個のプリセットを備えた10バンドイコライザー。</string>
    <string name="section_conv_title">コンボルバー</string>
    <string name="section_conv_summary">インパルス応答を適用します: 部屋、スピーカー、ヘッドホンのターゲット。</string>
    <string name="section_mbc_title">マルチバンドコンプレッサー</string>
    <string name="section_mbc_summary">低域・中域・高域を個別に圧縮。ポンピングのない密度の高い均一な音に。</string>
    <string name="section_deq_title">ダイナミック EQ</string>
    <string name="section_deq_summary">必要なときだけ働く EQ。低音の膨らみと耳障りな音を抑え、小音量では細部を持ち上げます。</string>
    <string name="section_deess_title">デエッサー</string>
    <string name="section_deess_summary">鋭い「サ」「タ」音を和らげます。</string>
    <string name="section_vocal_title">ボーカルとアンビエンス</string>
    <string name="section_vocal_summary">中央（声）を周囲から分離: セリフ強調やカラオケに。約21 ms のレイテンシが追加されます。</string>
    <string name="section_spatial_title">空間オーディオ</string>
    <string name="section_spatial_summary">実測した頭部（MIT KEMAR、710方向）に基づくヘッドホン用バーチャルスピーカー。3DoFヘッドトラッキング（回転・傾き・ロール）対応。</string>
    <string name="section_field_title">フィールドサラウンド</string>
    <string name="section_field_summary">ステレオイメージを広げます。</string>
    <string name="section_diff_title">ディファレンシャルサラウンド</string>
    <string name="section_diff_summary">Haas 効果による広がり。</string>
    <string name="section_stereo_title">Stereo widening</string>
    <string name="section_stereo_summary">センターを保ったまま音像を広げます。</string>
    <string name="section_vhe_title">ヘッドホンサラウンド+</string>
    <string name="section_vhe_summary">ヘッドホン用のバーチャルスピーカー。</string>
    <string name="section_reverb_title">リバーブ</string>
    <string name="section_reverb_summary">部屋の残響。</string>
    <string name="section_dyn_title">ダイナミックシステム</string>
    <string name="section_dyn_summary">ヘッドホンの種類に合わせたダイナミック低音。</string>
    <string name="section_tube_title">真空管シミュレーター</string>
    <string name="section_tube_summary">6N1J 真空管の温かみ。</string>
    <string name="section_bass_title">低音エンハンサー</string>
    <string name="section_bass_summary">深く制御された低域。</string>
    <string name="section_clarity_title">明瞭度エンハンサー</string>
    <string name="section_clarity_summary">高域の細部とボーカルの存在感。</string>
    <string name="section_cure_title">聴覚保護</string>
    <string name="section_cure_summary">ヘッドホンの聴取疲労を減らすクロスフィード。</string>
    <string name="section_analogx_title">AnalogX</string>
    <string name="section_analogx_summary">アナログコンソールの倍音着色。</string>
    <string name="section_speaker_title">スピーカー補正</string>
    <string name="section_speaker_summary">スマートフォン、ノートPC、Bluetooth、車、テレビ、または実測したスピーカーに自然なバランスを。</string>
    <string name="section_protect_title">スピーカー保護</string>
    <string name="section_protect_summary">小型スピーカーが再生できない低音を抑え、ビビりや歪みなく大きな音量に。</string>
    <string name="section_xtc_title">スピーカー拡張</string>
    <string name="section_xtc_summary">クロストークキャンセル: スマートフォン、タブレット、ノートPCの端を越えるステレオ。</string>

