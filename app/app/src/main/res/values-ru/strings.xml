    <string name="section_master_title">Мастер</string>
    <string name="section_master_summary">Усиление выхода, баланс и финальный лимитер.</string>
    <string name="section_autoeq_title">AutoEQ</string>
    <string name="section_autoeq_summary">Измеренная коррекция для тысяч наушников — звук, задуманный производителем.</string>
    <string name="section_loud_title">Компенсация громкости</string>
    <string name="section_loud_summary">Сохраняет низкие и высокие частоты на малой громкости по кривым равной громкости ISO 226.</string>
    <string name="section_peq_title">Параметрический эквалайзер</string>
    <string name="section_peq_summary">Свои фильтры: пики, полки, срезы и вырезы, до 32 полос.</string>
    <string name="section_geq_title">Точный графический эквалайзер</string>
    <string name="section_geq_summary">15 или 31 полоса, каждый ползунок с точностью до доли дБ.</string>
    <string name="section_agc_title">Управление усилением воспроизведения</string>
    <string name="section_agc_summary">Поднимает тихие треки и видео до ровного уровня. Для коротких звуков используйте компрессор.</string>
    <string name="section_fet_title">FET-компрессор</string>
    <string name="section_fet_summary">Студийный компрессор с автоматическими атакой, восстановлением и коленом.</string>
    <string name="section_ddc_title">Коррекция наушников</string>
    <string name="section_ddc_summary">Коррекция АЧХ по профилю .vdc.</string>
    <string name="section_vse_title">Расширение спектра</string>
    <string name="section_vse_summary">Восстанавливает высокие частоты, потерянные при сжатии с потерями.</string>
    <string name="section_eq_title">Эквалайзер</string>
    <string name="section_eq_summary">10-полосный эквалайзер с %1$d пресетами.</string>
    <string name="section_conv_title">Свёрточный фильтр</string>
    <string name="section_conv_summary">Применяет импульсную характеристику: комнаты, колонки, целевые наушники.</string>
    <string name="section_mbc_title">Многополосный компрессор</string>
    <string name="section_mbc_summary">Сжимает низкие, средние и высокие отдельно: плотнее и ровнее без «качки».</string>
    <string name="section_deq_title">Динамический эквалайзер</string>
    <string name="section_deq_summary">Эквалайзер, который работает только когда нужно: укрощает гул и резкость, добавляет детали на малой громкости.</string>
    <string name="section_deess_title">Де-эссер</string>
    <string name="section_deess_summary">Смягчает резкие звуки «с» и «ш».</string>
    <string name="section_vocal_title">Вокал и атмосфера</string>
    <string name="section_vocal_summary">Отделяет центр (голоса) от окружения: усиление диалогов или караоке. Добавляет ~21 мс задержки.</string>
    <string name="section_spatial_title">Пространственный звук</string>
    <string name="section_spatial_summary">Виртуальные колонки в комнате для наушников, измеренные на реальной голове (MIT KEMAR, 710 положений), с 3DoF-трекингом: поворот, наклон и крен.</string>
    <string name="section_field_title">Полевой surround</string>
    <string name="section_field_summary">Расширяет стереопанораму.</string>
    <string name="section_diff_title">Дифференциальный surround</string>
    <string name="section_diff_summary">Просторность по эффекту Хааса.</string>
    <string name="section_vhe_title">Surround для наушников+</string>
    <string name="section_vhe_summary">Виртуальные колонки для наушников.</string>
    <string name="section_reverb_title">Реверберация</string>
    <string name="section_reverb_summary">Атмосфера комнаты.</string>
    <string name="section_dyn_title">Динамическая система</string>
    <string name="section_dyn_summary">Динамические басы под тип наушников.</string>
    <string name="section_tube_title">Ламповый симулятор</string>
    <string name="section_tube_summary">Тепло ламп 6N1J.</string>
    <string name="section_bass_title">Усилитель басов</string>
    <string name="section_bass_summary">Глубокий контролируемый низ.</string>
    <string name="section_clarity_title">Усилитель ясности</string>
    <string name="section_clarity_summary">Детали высоких и присутствие вокала.</string>
    <string name="section_cure_title">Защита слуха</string>
    <string name="section_cure_summary">Кроссфид, снижающий усталость при прослушивании в наушниках.</string>
    <string name="section_analogx_title">AnalogX</string>
    <string name="section_analogx_summary">Гармоническая окраска аналоговой консоли.</string>
    <string name="section_speaker_title">Коррекция колонок</string>
    <string name="section_speaker_summary">Естественный баланс для колонок телефона, ноутбука, Bluetooth, автомобиля и ТВ — или ваших, измеренных.</string>
    <string name="section_protect_title">Защита колонок</string>
    <string name="section_protect_summary">Сдерживает басы, которые не может воспроизвести маленькая колонка, чтобы играть громче без дребезга и искажений.</string>
    <string name="section_xtc_title">Расширение колонок</string>
    <string name="section_xtc_summary">Подавление перекрёстных помех: стерео, выходящее за края телефона, планшета или ноутбука.</string>

