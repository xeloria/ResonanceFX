    <string name="channel_service">이펙트 엔진</string>
    <string name="notification_text">%1$s 프로필 · 연결된 스트림: %2$d</string>

    <string name="section_master_title">마스터</string>
    <string name="section_master_summary">출력 게인, 밸런스 및 최종 리미터.</string>
    <string name="section_autoeq_title">AutoEQ</string>
    <string name="section_autoeq_summary">수천 개 헤드폰을 위한 실측 보정 — 제조사가 의도한 소리.</string>
    <string name="section_loud_title">라우드니스 보정</string>
    <string name="section_loud_summary">ISO 226 등청감 곡선에 따라 낮은 볼륨에서도 저음과 고음을 유지합니다.</string>
    <string name="section_peq_title">파라메트릭 EQ</string>
    <string name="section_peq_summary">피크, 셸프, 패스, 노치 필터를 최대 32밴드까지.</string>
    <string name="section_geq_title">정밀 그래픽 EQ</string>
    <string name="section_geq_summary">15 또는 31밴드, 각 슬라이더를 1dB 이하 단위로 조정.</string>
    <string name="section_agc_title">재생 게인 제어</string>
    <string name="section_agc_summary">조용한 트랙과 동영상을 일정한 레벨로 올립니다. 짧은 소리에는 컴프레서를 사용하세요.</string>
    <string name="section_fet_title">FET 컴프레서</string>
    <string name="section_fet_summary">어택, 릴리즈, 니가 자동인 스튜디오형 컴프레서.</string>
    <string name="section_ddc_title">헤드폰 보정</string>
    <string name="section_ddc_summary">.vdc 헤드셋 프로필로 주파수 응답을 보정합니다.</string>
    <string name="section_vse_title">스펙트럼 확장</string>
    <string name="section_vse_summary">손실 압축으로 잃은 고주파를 복원합니다.</string>
    <string name="section_eq_title">이퀄라이저</string>
    <string name="section_eq_summary">%1$d개 프리셋이 있는 10밴드 이퀄라이저.</string>
    <string name="section_conv_title">컨볼버</string>
    <string name="section_conv_summary">임펄스 응답 적용: 룸, 스피커, 헤드폰 타깃.</string>
    <string name="section_mbc_title">멀티밴드 컴프레서</string>
    <string name="section_mbc_summary">저역, 중역, 고역을 따로 압축: 펌핑 없이 더 밀도 있고 고른 소리.</string>
    <string name="section_deq_title">다이내믹 EQ</string>
    <string name="section_deq_summary">필요할 때만 작동하는 EQ: 붐과 거친 소리를 억제하고 작은 볼륨에서 디테일을 살립니다.</string>
    <string name="section_deess_title">디에서</string>
    <string name="section_deess_summary">날카로운 ‘ㅅ’과 ‘ㅌ’ 소리를 부드럽게.</string>
    <string name="section_vocal_title">보컬과 앰비언스</string>
    <string name="section_vocal_summary">중앙(목소리)을 주변에서 분리: 대사 강조 또는 노래방. 약 21ms 지연이 추가됩니다.</string>
    <string name="section_spatial_title">공간 오디오</string>
    <string name="section_spatial_summary">실제 머리(MIT KEMAR, 710개 방향)에서 측정한 헤드폰용 가상 스피커, 3DoF 헤드 트래킹(회전, 기울임, 롤).</string>
    <string name="section_field_title">필드 서라운드</string>
    <string name="section_field_summary">스테레오 이미지를 넓힙니다.</string>
    <string name="section_diff_title">디퍼런셜 서라운드</string>
    <string name="section_diff_summary">Haas 효과로 공간감을 줍니다.</string>
    <string name="section_vhe_title">헤드폰 서라운드+</string>
    <string name="section_vhe_summary">헤드폰용 가상 스피커.</string>
    <string name="section_reverb_title">리버브</string>
    <string name="section_reverb_summary">룸 앰비언스.</string>
    <string name="section_dyn_title">다이내믹 시스템</string>
    <string name="section_dyn_summary">헤드폰 유형에 맞춘 다이내믹 저음.</string>
    <string name="section_tube_title">진공관 시뮬레이터</string>
    <string name="section_tube_summary">6N1J 진공관의 따뜻함.</string>
    <string name="section_bass_title">저음 강화</string>
    <string name="section_bass_summary">깊고 제어된 저역.</string>
    <string name="section_clarity_title">명료도 강화</string>
    <string name="section_clarity_summary">고음 디테일과 보컬 존재감.</string>
    <string name="section_cure_title">청각 보호</string>
    <string name="section_cure_summary">헤드폰 청취 피로를 줄이는 크로스피드.</string>
    <string name="section_analogx_title">AnalogX</string>
    <string name="section_analogx_summary">아날로그 콘솔의 하모닉 컬러링.</string>
    <string name="section_speaker_title">스피커 보정</string>
    <string name="section_speaker_summary">휴대폰, 노트북, 블루투스, 자동차, TV 스피커 또는 측정한 스피커에 자연스러운 밸런스를.</string>
    <string name="section_protect_title">스피커 보호</string>
    <string name="section_protect_summary">작은 스피커가 재생할 수 없는 저음을 억제해 덜덜거림이나 왜곡 없이 더 크게.</string>
    <string name="section_xtc_title">스피커 확장</string>
    <string name="section_xtc_summary">크로스토크 제거: 휴대폰, 태블릿, 노트북 가장자리를 넘어서는 스테레오.</string>

